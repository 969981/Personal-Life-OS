---
import BaseLayout from '../layouts/BaseLayout.astro';
import { visibleNotes, sectionNotes, noteHref, dateText, noteDate } from '../lib/notes';
const photos=sectionNotes(await visibleNotes(),'photo').filter((item)=>Boolean(item.data.photo_file));
---
<BaseLayout title="相册" active="photos">
  <p class="page-eyebrow">PHOTO JOURNAL / MEMORIES</p>
  <h1 class="page-title">把时间留在照片里。</h1>
  <p class="page-description">把散落的照片串成生活的时间线。原图仅保存在你的电脑里，网页使用重新编码、默认不含原始 EXIF/GPS 的 WebP 图片。</p>
  {photos.length ? <section class="photo-grid" aria-label="照片列表">
    {photos.map((item)=><a class="photo-card" href={noteHref(item)}>
      <img src={'/_gallery/'+item.data.photo_file} alt={item.data.title} loading="lazy" decoding="async" />
      <div class="photo-card-caption"><strong>{item.data.title}</strong><span>{dateText(noteDate(item))}</span></div>
    </a>)}
  </section> : <div class="photo-placeholder">
    <span class="photo-icon">▧</span>
    <h2>还没有可展示的照片</h2>
    <p>在本机使用 <code>npm run photos:import</code> 导入图片，然后运行 <code>npm run dev:private</code> 查看私人相册。当前 Public 仓库不会提交照片。</p>
    <a class="button" href="/diary">先看看日记 ↗</a>
  </div>}
</BaseLayout>
