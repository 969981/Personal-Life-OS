---
import BaseLayout from '../layouts/BaseLayout.astro';
import { visibleNotes } from '../lib/notes';
import { timelineItems } from '../lib/knowledge.mjs';
const entries=timelineItems(await visibleNotes());
---
<BaseLayout title="碎碎念" active="moments">
  <p class="page-eyebrow">LITTLE THOUGHTS / MOMENTS</p>
  <h1 class="page-title">碎碎念，都有迹可循。</h1>
  <p class="page-description">无论是在 Obsidian QuickAdd 里写进 Diary 的 Timeline，还是独立的 Moments 笔记，都会按日期和时间合并在这里。</p>
  <div style="margin-bottom:24px"><a class="button primary" href="/capture">＋ 随手记一句</a></div>
  {entries.length ? <section class="timeline">
    {entries.map((entry)=><article class="timeline-item">
      <time datetime={entry.date+'T'+(entry.time||'00:00')}>{entry.date} {entry.time}</time>
      <h2>{entry.icon} {entry.title}</h2>
      {entry.kind==='moment'&&entry.summary&&<p>{entry.summary}</p>}
      <a class="inline-link" href={entry.href}>{entry.kind==='diary'?'查看当日日记 ↗':'打开完整笔记 ↗'}</a>
    </article>)}
  </section> : <div class="empty"><strong>时间线还空着</strong>在手机「随手记」或 Obsidian QuickAdd 留下一句话，保存到 Diary 的 Timeline 即可。</div>}
</BaseLayout>